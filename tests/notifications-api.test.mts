import {test} from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';import {signSession} from '../src/lib/coach/session';
const env=Object.fromEntries(readFileSync('.env.local','utf8').trim().split('\n').map(l=>{const i=l.indexOf('=');return [l.slice(0,i),l.slice(i+1).trim()]}));assert.equal(env.SUPABASE_URL,'http://127.0.0.1:54390');
const base='http://localhost:4183',url=base+'/api/coach/billing/notifications';
async function call(role:string|null,method='GET',origin=base,team='team-review-warriors',org='org-outlaws'){const cookie=role?'ec_coach_session='+await signSession({orgId:org,role} as any,env.SESSION_SECRET,3600):'';return fetch(url+(method==='GET'?'?team='+team:''),{method,headers:{cookie,origin,'Content-Type':'application/json'},body:method==='POST'?JSON.stringify({team,action:'test',to:'attacker@example.test'}):undefined});}
test('notification settings require both team session and verified owner',async()=>{assert.equal((await call(null)).status,401);assert.equal((await call('owner')).status,403);assert.equal((await call('viewer','POST')).status,403);assert.equal((await call('owner','POST','https://foreign.example')).status,403);assert.equal((await call('owner','GET',base,'team-review-warriors','org-review-talking')).status,404);});
