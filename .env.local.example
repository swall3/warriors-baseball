# Copy this to .env.local and fill in your values
# Add the same vars to your Vercel project settings

# Supabase (Settings > API in your Supabase project)
SUPABASE_URL=https://your-project-id.supabase.co

# Service-role key — bypasses RLS. Used by everything under /api/coach.
# This is defect T2 (MULTI-TENANT-PLAN.md §0.3) and it is removed from the
# request path in MT-3 (§3.4 Stage B), leaving it only in the migration runner
# and cross-tenant admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon key — RLS APPLIES. Used by exactly one route: the public tryout signup
# form (src/app/api/signup/route.ts). It does one INSERT and has no business
# holding a key that can read every row of every tenant, so it gets this one
# instead, policed by migration 013's `public_signup_insert` policy.
#
# ⚠️ NOT SET IN VERCEL YET — set it there (it is safe to expose; it is the key
# Supabase ships to browsers). Until it is, getPublicSupabaseClient() falls
# back to the service-role key and logs a warning, so the signup form keeps
# working but the policy is bypassed in production. Setting it is what closes
# that gap, and the fallback should be deleted once it is set.
SUPABASE_ANON_KEY=your-anon-key

# The owner organization — tenant #1, seeded by migration 007. Optional; the
# default is 'org-outlaws'. This is the ONE tenancy value that may live in an
# env var, and only because the public marketing site is single-tenant by
# decision (MULTI-TENANT-PLAN.md §5.1/§5.2). Per-org config that has to differ
# per request — branding, team names, icons — is data in
# `organizations.branding`, never an env var (§4.1).
#
# ⚠️ If you change it, change the hardcoded 'org-outlaws' in migration 013's
# public_signup_insert policy to match, or every tryout submission is refused.
# OWNER_ORG_ID=org-outlaws

# Coach gate passcode — the OWNER org's passcode, and as of MT-3 no longer the
# only one (src/lib/coach/auth.ts). Every other tenant's passcode lives in the
# org_passcodes table as a salted hash (migration 015), where it can differ per
# org; this env var remains because it is how org-outlaws logs in today and
# because changing that in the same deploy as everything else would be the one
# regression MT-3 must not have. src/app/api/coach/login/route.ts tries the
# table first and this second.
#
# Migrate it with scripts/seed-owner-passcode.mjs (reads this var, stores only
# the hash, never prints the value), after which this var can be retired.
#
# There is deliberately no second password: the old ADMIN_PASSWORD / /admin
# pair was a parallel auth system and was deleted in MT-1.
APP_PASSCODE=choose-a-passcode

# HMAC key for the signed coach session cookie (MULTI-TENANT-PLAN §3.2).
#
# The MT-2 cookie was sha256(salt:passcode) — a bare value with no integrity
# binding, which was fine while it asserted nothing but "someone knows the
# passcode". The MT-3 cookie carries an ORG ID, and an unsigned org id is a
# tenancy bypass you can type by hand. This key is what makes it a claim the
# server issued.
#
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# ⚠️ NOT SET IN VERCEL YET — set it there, marked Sensitive (§7 MT-3 step 3).
# Until it is, login falls back to minting the MT-2 unsigned cookie for the
# OWNER org only and REFUSES every other tenant with a 503, so a deploy that
# lands before the env var keeps org-outlaws working exactly as today and
# cannot drop a second tenant into org-outlaws' data. Setting it is what turns
# multi-tenant login on. Delete that fallback once it is set.
#
# ⚠️ Rotating this value invalidates every live session — every coach is logged
# out and re-enters their passcode. Nothing is lost (localStorage is untouched),
# but do not rotate it on a game day.
SESSION_SECRET=generate-a-long-random-value

# Billing remains disabled until a Stripe test account is connected. Server-only.
# BILLING_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TEAM_MONTHLY_PRICE_ID=price_...
# STRIPE_TEAM_ANNUAL_PRICE_ID=price_...
# BILLING_APP_URL=https://warriors-baseball-omega.vercel.app
# BILLING_TRIAL_DAYS=0
# BILLING_ENFORCE=false
