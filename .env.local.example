# Copy this to .env.local and fill in your values
# Add the same vars to your Vercel project settings

# Supabase (Settings > API in your Supabase project)
SUPABASE_URL=https://your-project-id.supabase.co

# Service-role key — bypasses RLS. Used by everything under /api/coach.
# This is defect T2 (MULTI-TENANT-PLAN.md §0.3) and it is removed from the
# request path in MT-3 (§3.4 Stage B), leaving it only in the migration runner
# and cross-tenant admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon key — RLS APPLIES. Used by exactly one route: the public tryout signup
# form (src/app/api/signup/route.ts). It does one INSERT and has no business
# holding a key that can read every row of every tenant, so it gets this one
# instead, policed by migration 013's `public_signup_insert` policy.
#
# ⚠️ NOT SET IN VERCEL YET — set it there (it is safe to expose; it is the key
# Supabase ships to browsers). Until it is, getPublicSupabaseClient() falls
# back to the service-role key and logs a warning, so the signup form keeps
# working but the policy is bypassed in production. Setting it is what closes
# that gap, and the fallback should be deleted once it is set.
SUPABASE_ANON_KEY=your-anon-key

# The owner organization — tenant #1, seeded by migration 007. Optional; the
# default is 'org-outlaws'. This is the ONE tenancy value that may live in an
# env var, and only because the public marketing site is single-tenant by
# decision (MULTI-TENANT-PLAN.md §5.1/§5.2). Per-org config that has to differ
# per request — branding, team names, icons — is data in
# `organizations.branding`, never an env var (§4.1).
#
# ⚠️ If you change it, change the hardcoded 'org-outlaws' in migration 013's
# public_signup_insert policy to match, or every tryout submission is refused.
# OWNER_ORG_ID=org-outlaws

# Coach gate passcode — the single shared secret for /coach and /api/coach
# (src/lib/coach/auth.ts). There is deliberately no second password: the old
# ADMIN_PASSWORD / /admin pair was a parallel auth system and was deleted.
APP_PASSCODE=choose-a-passcode
