{
  "name": "Ninety Feet Coach",
  "short_name": "Coach",
  "description": "Team scorekeeping, spray charts, lineups and game stats.",
  "start_url": "/coach",
  "scope": "/coach",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#f8fafc",
  "theme_color": "#111827",
  "categories": [
    "sports",
    "productivity"
  ],
  "icons": [
    {
      "src": "/coach/icons/coach-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Score Game",
      "short_name": "Score",
      "url": "/coach",
      "icons": [
        {
          "src": "/coach/icons/coach-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Stats",
      "short_name": "Stats",
      "url": "/coach/stats",
      "icons": [
        {
          "src": "/coach/icons/coach-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml",
          "purpose": "any"
        }
      ]
    }
  ]
}
