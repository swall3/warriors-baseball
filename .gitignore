# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
.vercel
.env*
.shots/
supabase/.temp/

# Local dev DB fallback (src/lib/coach/local-db.ts writes here when Supabase is
# unconfigured). Per-machine scratch, never the source of truth — the bundled
# src/lib/coach/seed-db.json is.
data/

# Provisioned tenant credentials (scripts/create-org.mjs prints a passcode once).
# The database stores only a salted SHA-256; the plaintext exists here and in
# the customer's hands, and must never reach a commit.
*-CREDENTIALS.txt

# Mobile pilot binaries and signing material stay outside Git.
mobile/dist/
mobile/ios/
mobile/android/.gradle/
mobile/android/**/build/
mobile/android/local.properties
mobile/**/*.keystore
